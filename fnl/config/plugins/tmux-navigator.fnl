

[{1 :christoomey/vim-tmux-navigator
  :cmd [:TmuxNavigateLeft :TmuxNavigateDown :TmuxNavigateRight :TmuxNavigateUp]
  :keys [{:mode [:n :i :t] 1 "<m-h>" 2 "<cmd>TmuxNavigateLeft<cr>" :desc "Left Pane"}
	 {:mode [:n :i :t] 1 "<m-j>" 2 "<cmd>TmuxNavigateDown<cr>" :desc "Below Pane"}
	 {:mode [:n :i :t] 1 "<m-k>" 2 "<cmd>TmuxNavigateUp<cr>" :desc "Above Pane"}
	 {:mode [:n :i :t] 1 "<m-l>" 2 "<cmd>TmuxNavigateRight<cr>" :desc "Right Pane"}]}]
